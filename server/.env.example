PORT=8080
DATABASE_URL=postgres://primetv:change-me@localhost:5432/primetv
# Supabase migration'larında Direct veya Session pooler (5432) adresi:
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=10
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
LICENSE_SIGNING_PRIVATE_KEY_FILE=./secrets/license-private.pem
# Vercel'de dosya yerine özel anahtarın base64 değeri kullanılır:
LICENSE_SIGNING_PRIVATE_KEY_BASE64=
LICENSE_TOKEN_TTL_SECONDS=604800
ADMIN_SESSION_TTL_SECONDS=43200
NODE_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8080
TRUST_PROXY=false
PAYMENT_WEBHOOK_SECRET=
REMOTE_PROFILE_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
PRIVACY_CONTROLLER_NAME=PrimeTV Development
PRIVACY_CONTACT_EMAIL=privacy@example.com
PRIVACY_EFFECTIVE_DATE=2026-08-14
AUDIT_RETENTION_DAYS=180
PAIRING_METADATA_RETENTION_DAYS=30
PAYMENT_RAW_EVENT_RETENTION_DAYS=30
PRIVACY_REQUEST_RETENTION_DAYS=365
DEVICE_TOMBSTONE_RETENTION_DAYS=365
