{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/setup", "destination": "/setup/setup.html" },
    { "source": "/setup/", "destination": "/setup/setup.html" },
    { "source": "/remote", "destination": "/remote/index.html" },
    { "source": "/remote/", "destination": "/remote/index.html" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/privacy", "destination": "/api/index" },
    { "source": "/privacy/:path*", "destination": "/api/index" },
    { "source": "/v1/:path*", "destination": "/api/index" },
    { "source": "/", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/setup/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/remote/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
