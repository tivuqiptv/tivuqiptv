{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/admin", "destination": "/server/public/admin/index.html" },
    { "source": "/admin/", "destination": "/server/public/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/server/public/admin/:path*" },
    { "source": "/setup", "destination": "/server/public/setup/setup.html" },
    { "source": "/setup/", "destination": "/server/public/setup/setup.html" },
    { "source": "/setup/:path*", "destination": "/server/public/setup/:path*" },
    { "source": "/health", "destination": "/server/api/index.js" },
    { "source": "/privacy", "destination": "/server/api/index.js" },
    { "source": "/privacy/:path*", "destination": "/server/api/index.js" },
    { "source": "/v1/:path*", "destination": "/server/api/index.js" },
    { "source": "/", "destination": "/server/public/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/setup/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
